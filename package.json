{
  "name": "savestate",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests supabase docs/decisiones_aprobadas.md README.md *.json *.mjs",
    "format:check": "prettier --check src tests supabase docs/decisiones_aprobadas.md README.md *.json *.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "lucide-react": "^0.468.0",
    "canvas-confetti": "^1.9.3",
    "isomorphic-dompurify": "^3.0.0",
    "marked": "^17.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "typescript": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.0.0"
  }
}
