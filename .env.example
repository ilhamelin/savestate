# Public Supabase connection; the anon key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Public IGDB ingestion and signing Steam import previews.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Register an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional server-only key for the Steam library importer.
STEAM_API_KEY=
# Optional server-only console sync credentials. Never use NEXT_PUBLIC_* for these.
PSN_NPSSO=
XBL_API_KEY=
# Optional Discord Bridge credentials (server only). Use a dedicated community channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional read-only frequencies; IDs must belong to the same server as DISCORD_CHANNEL_ID.
# If empty, discover a unique text channel by its checkpoints/anuncios-savestate name.
DISCORD_CHECKPOINTS_CHANNEL_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_PRIVATE_CHAT_CHANNEL_ID=747219024324198532
DISCORD_WEBHOOK_URL=
DISCORD_APPLICATION_ID=1557446548982464652
DISCORD_PUBLIC_KEY=6ae28438c8aabef52a28b13d1f5ef1714c9ce11a71a5b47b70d466d247981450
# Server-only OAuth secret for identify + role_connections.write; never expose publicly.
DISCORD_CLIENT_SECRET=
# Server only. Random secret of at least 32 characters; protects /api/cron/check-itch.
CRON_SECRET=
DISCORD_INVITE_URL=https://discord.gg/532ZQzVXCp
# Use http://localhost:3000 in .env.local when running the local app.
NEXT_PUBLIC_APP_URL=https://savestate-eight.vercel.app
# Optional isolated local database for SQL integration tests (never production).
TEST_DATABASE_URL=
# Rift Tracker: server-only Riot Games API key. Never use NEXT_PUBLIC_*.
RIOT_API_KEY=

# Optional server-only HenrikDev key for Valorant MMR and match history.
HENRIK_API_KEY=
TMDB_API_KEY=
TMDB_READ_TOKEN=
NEXT_PUBLIC_JUSTWATCH_DEFAULT_REGION=CL

# Comma-separated immutable Supabase user UUIDs (never editable usernames).
DISCORD_PRIVATE_CHAT_ALLOWED_USERS=

# Cloudflare R2 vault. Server-only; never commit real credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=savestate-vault
R2_PUBLIC_URL=https://pub-83372560eadf4eadac2d1835674c6840.r2.dev

# Guardian: disabled until explicitly activated. Never prefix the seed with NEXT_PUBLIC_.
GATEKEEPER_ENABLED=false
# Cryptographically random Base32 (A-Z, 2-7), at least 32 characters. No default seed.
GATEKEEPER_SECRET=
# Prefer immutable Supabase UUID; when provided, it takes precedence over email.
ADMIN_USER_ID=
ADMIN_EMAIL=benjaigancioreyes56@gmail.com
# Display/reference only; editable usernames do not grant administrator privileges.
ADMIN_USERNAME=ilhamelin_v2

# Optional display-only Supabase node labels, confirmed in the project dashboard.
# CPU/RAM/disk use Metrics API with SUPABASE_SERVICE_ROLE_KEY; no fabricated defaults.
GUARDIAN_DB_NODE=
GUARDIAN_DB_REGION=

# SPEC-05 support integration. Server-only; apply migration 040 first.
JIRA_INSTANCE_URL=https://portal-solicitudes-dev.atlassian.net
JIRA_PORTAL_URL=https://portal-solicitudes-jira.vercel.app
JIRA_API_URL=https://jira-portal-solicitudes.onrender.com/api/v1
JIRA_PROJECT_KEY=SOL
# Bearer JWT from a dedicated Portal account (solicitante or coordinador).
# Never use NEXT_PUBLIC_ or a personal Atlassian API token here; rotate when expired.
JIRA_PORTAL_TOKEN=

# SPEC-06 Guardian Cloud / CI monitor (optional; server-only, never NEXT_PUBLIC_*).
# Vercel token scoped to this project/team; no deployment mutation permissions are used.
VERCEL_TOKEN=
# ID or name; defaults to savestate. Team ID is optional for team-owned projects.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Fine-grained GitHub token: ilhamelin/savestate only, Actions/Contents/Pull requests read-only.
# Without a token, public reads are spaced 5 minutes apart rather than 30 seconds.
GITHUB_TOKEN=
