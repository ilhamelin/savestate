# Public Supabase connection; the anon key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Public IGDB ingestion and signing Steam import previews.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Register an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional server-only key for the Steam library importer.
STEAM_API_KEY=
# Optional server-only console sync credentials. Never use NEXT_PUBLIC_* for these.
PSN_NPSSO=
XBL_API_KEY=
# Optional Discord Bridge credentials (server only). Use a dedicated community channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional read-only frequencies; IDs must belong to the same server as DISCORD_CHANNEL_ID.
# If empty, discover a unique text channel by its checkpoints/anuncios-savestate name.
DISCORD_CHECKPOINTS_CHANNEL_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DISCORD_APPLICATION_ID=1557446548982464652
DISCORD_PUBLIC_KEY=6ae28438c8aabef52a28b13d1f5ef1714c9ce11a71a5b47b70d466d247981450
# Server-only OAuth secret for identify + role_connections.write; never expose publicly.
DISCORD_CLIENT_SECRET=
# Server only. Random secret of at least 32 characters; protects /api/cron/check-itch.
CRON_SECRET=
DISCORD_INVITE_URL=https://discord.gg/532ZQzVXCp
# Use http://localhost:3000 in .env.local when running the local app.
NEXT_PUBLIC_APP_URL=https://savestate-eight.vercel.app
# Optional isolated local database for SQL integration tests (never production).
TEST_DATABASE_URL=
# Rift Tracker: server-only Riot Games API key. Never use NEXT_PUBLIC_*.
RIOT_API_KEY=

# Optional server-only HenrikDev key for Valorant MMR and match history.
HENRIK_API_KEY=
